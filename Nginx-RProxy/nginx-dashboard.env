# version: 20260522-01


PORT=3000

# Endpoint VTS interne (conteneur nginx)
NGINX_VTS_URL=http://nginx:8080/status.json 

# Nom du conteneur nginx pour docker exec (nginx -t / nginx -s reload)
NGINX_CONTAINER=nginx

# Docker socket pour API exec
DOCKER_SOCKET=/var/run/docker.sock

# Auth
USERS_FILE=/config/users.yml

# Répertoires de configuration montés
DIR_SITES=/nginx/sites
DIR_CONF=/nginx/conf
DIR_SNIPPETS=/nginx/snippets
DIR_STREAMS=/nginx/streams
DIR_SSL=/nginx/ssl
DIR_CERTS=/nginx/certs
DIR_LOGS=/nginx/logs
DIR_GOACCESS=/nginx/goaccess
