# name: allow-visit-001
# description: Autorise seulement les visites depuis des IPs en France / Grande Bretagne et Irlance, IP Privee et les Good bots pour indexation
# require: geoip2-load-database,good-bots,private-ips
# usage: ajouter le snippet allow-visit-002.conf dans le virtualhost
# version: 1.0.0

# Autorise seulement les visites depuis des IPs en France / Grande Bretagne et Irlance, IP Privee et les Good bots pour indexation
#
# Utilisation des virtualhost
# if ($allow_visit_002 = 0) {
#   return 403;
# }

map "$geoip2_data_country_iso_code:$is_good_bot:$is_private_ip" $allow_visit_002 {
    default 0;          # Bloque  par defaut

    "~^FR:"    1;       # Autorise si Pays = FR
    "~^IE:"    1;       # Irlande
    "~^GB:"    1;       # Grande bretage
    "~:1:"     1;       # Autorise si c'est un Bot (peu importe le pays)
    "~:1$"     1;       # Autorise si ip privee
}