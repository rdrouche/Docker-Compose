# TIKA
#TIKA_MEMORY_LIMIT=512m

# Header 64Ko
#PROXY_HTTP_MAX_HEADER_BYTES=65536
#HTTP_MAX_HEADER_BYTES=65536
# Header 128Ko
#PROXY_HTTP_MAX_HEADER_BYTES=131072
#HTTP_MAX_HEADER_BYTES=131072