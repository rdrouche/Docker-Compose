# ============================================================
#  CodeLaunch v1.2.0 — Configuration
# ============================================================

# ── Application ────────────────────────────────────────────
APP_PORT=3000
NODE_ENV=production
APP_PUBLIC_URL=https://launch.example.com

# ── Branding ───────────────────────────────────────────────
BRAND_NAME=CodeLaunch
BRAND_LOGO_URL=
BRAND_PRIMARY_COLOR=#2ea8ff
BRAND_ACCENT_COLOR=#00e5c0

# ── Domaines ───────────────────────────────────────────────
BASE_UI_DOMAIN=launch.example.com
BASE_URI=codes.example.com
DOCKER_NETWORK=proxy

# ── Authentification ───────────────────────────────────────
# Les modes sont cumulables — activer un ou plusieurs

# Mode 1: Email direct → lancement immédiat → MdP par email
AUTH_EMAIL_ENABLED=true

# Mode 2: Magic link → lien par email → clic → Code Server direct
AUTH_MAGIC_LINK=false

# Mode 3: OIDC/SSO → IdP → Code Server direct (MdP permanent auto)
AUTH_OIDC_ENABLED=false
OIDC_ISSUER=https://accounts.example.com
OIDC_CLIENT_ID=codelaunch
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=https://launch.example.com/api/auth/oidc/callback
OIDC_BUTTON_LABEL=Se connecter avec SSO

# ── Mode test emails ────────────────────────────────────────
# true  = aucun email envoyé, contenu affiché dans les logs Docker
# false = envoi SMTP réel (production)
MAIL_TEST_MODE=true

# ── SMTP ───────────────────────────────────────────────────
# Obligatoire si MAIL_TEST_MODE=false
SMTP_HOST=smtp.example.com
SMTP_PORT=587
# true = TLS/SSL (port 465), false = STARTTLS (port 587)
SMTP_SECURE=false
SMTP_USER=user@example.com
SMTP_PASS=votre_mot_de_passe
SMTP_FROM=noreply@example.com
# false = accepter certificats auto-signés (serveur interne)
SMTP_TLS_REJECT_UNAUTHORIZED=true

# ── API externe ────────────────────────────────────────────
# Clé API pour injection d'utilisateurs depuis une app externe
# Laisser vide pour désactiver
API_KEY=

# ── Limites ────────────────────────────────────────────────
# 0 = illimité
MAX_CONTAINERS=50
CODE_SERVER_IMAGE=lscr.io/linuxserver/code-server

# ── Domaines autorisés (séparés par ,) ─────────────────────
# Vide = tous les domaines acceptés
# Les utilisateurs blacklistés sont bloqués même si domaine autorisé
# Les utilisateurs whitelistés passent même si domaine interdit
ALLOWED_DOMAINS=example.com

# ── Données Code Server ────────────────────────────────────
CODE_SERVER_DATA_PATH=/code-server-data
CODE_SERVER_PASSWD_PATH=/var/lib/code-server
TZ=Europe/Paris

# ── Admin ──────────────────────────────────────────────────
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changez_ce_mot_de_passe
# Clé de chiffrement des mots de passe permanents (min 32 chars)
ADMIN_SESSION_SECRET=chaine_aleatoire_minimum_32_caracteres_ici