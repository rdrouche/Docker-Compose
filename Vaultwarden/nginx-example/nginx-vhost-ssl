server{
    listen 443 ssl http2;
    server_name vault.domain.tld;
    access_log /var/log/nginx/vault.domain.tld_access.log;
    error_log /var/log/nginx/vault.domain.tld_access.log;
    ssl_certificate /path/certificate/ssl/certificate.cert;
    ssl_certificate_key /path/certificate/key/certificate.key;

    location / {
        proxy_pass http://127.0.0.1:8080;
        proxy_ssl_verify off;
        proxy_redirect  off;
        proxy_set_header  Host  $host;
        proxy_set_header  X-Real-IP $remote_addr;
        proxy_set_header  X-Forwarded-Forwarded $proxy_add_x_forwarded_for;
        client_max_body_size  256m;
        client_body_buffer_size 128k;
        proxy_connect_timeout 90;
        proxy_send_timeout    90;
        proxy_read_timeout    90;
        proxy_buffers         32 4k;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
    }
}

server{
    listen 80;
    server_name vault.domain.tld;

    location / {
        return 301 https://$server_name$request_uri;
    }    
}